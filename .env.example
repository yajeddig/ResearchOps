# ResearchOps - Environment variables template (local runs only).
# In GitHub Actions these are repository secrets. NEVER commit .env.

# === WF1 (Ingest) ===
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash            # optional override

# === WF2 (Monitor) and WF4 (Ask) ===
ANTHROPIC_API_KEY=your_claude_api_key_here
CLAUDE_MODEL=claude-opus-5               # optional override
SEMANTIC_SCHOLAR_API_KEY=                # optional, raises the rate limit

# === Notifications (Telegram) ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# === Provided automatically by GitHub Actions ===
# GITHUB_TOKEN, GITHUB_REPOSITORY, GITHUB_OUTPUT, ISSUE_NUMBER, ISSUE_TITLE, ISSUE_BODY
